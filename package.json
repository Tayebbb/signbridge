{
  "name": "signbridge",
  "version": "0.1.0",
  "description": "SignBridge experimental technical foundation",
  "scripts": {
    "dev": "npm run prepare:renderer && next dev --hostname 127.0.0.1",
    "build": "npm run prepare:renderer && next build && node scripts/check-workflow-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "prepare:renderer": "node scripts/prepare-renderer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "corpus:download": "node scripts/download-corpus.mjs",
    "corpus:import": "tsx scripts/corpus-import.ts",
    "corpus:probe": "node scripts/corpus-render-probe.cjs",
    "test:race:native": "vitest run --config vitest.native.config.ts",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "test:workspace": "playwright test --config playwright.workspace.config.ts",
    "test:product": "playwright test --config playwright.product.config.ts"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.4",
    "openai": "^7.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workflow": "^5.3.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "$zod",
    "undici@7.30.0": "7.30.1"
  }
}
