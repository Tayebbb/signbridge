# Optional secret: Neon PostgreSQL connection URL; unset uses local PGlite. Ask before using a real value.
DATABASE_URL=
# Optional local PGlite directory; default .data/postgres (no production persistence).
PGLITE_DATA_DIR=.data/postgres
# Processing switch, combined with the database kill switch; replay stays available when false.
PROCESSING_ENABLED=false
# Optional secret: OpenAI API credential; used only with MODEL_DRIVER=openai. Ask before use.
OPENAI_API_KEY=
# Optional secret: administrative bearer authorization token. Ask before use.
ADMIN_TOKEN=
# Optional nonsecret test-only directory containing PostgreSQL binaries; native race tests use a fresh loopback cluster.
PG_TEST_BIN=
# Model adapter: fake locally; explicitly openai in production. Fake provenance is labelled.
MODEL_DRIVER=fake
# Dispatcher: in-process locally; workflows in production (lease driver deferred).
JOB_DRIVER=in-process
# Blob adapter: filesystem locally; vercel for the private production store.
BLOB_DRIVER=filesystem
# Optional local Blob directory; default .data/blob.
LOCAL_BLOB_DIR=.data/blob
# Secret: cron bearer authorization. Ask before using a real value.
CRON_SECRET=
# Nonsecret: private Blob store identifier, paired with Vercel-managed OIDC.
BLOB_STORE_ID=
# Optional secret: Blob read-write token outside Vercel OIDC. Ask before use.
BLOB_READ_WRITE_TOKEN=
# Nonsecret canonical browser origin in production, e.g. https://your-domain.example (no trailing slash).
APP_ORIGIN=
