# Optional secret: Neon PostgreSQL connection URL; unset uses local PGlite. Ask before using a real value.
DATABASE_URL=
# Optional local PGlite directory; default .data/postgres (no production persistence).
PGLITE_DATA_DIR=.data/postgres
# Processing switch; phase 1 keeps processing disabled regardless of this value.
PROCESSING_ENABLED=false
# Phase 4 secret: OpenAI API credential; unused in phase 1. Ask before use.
OPENAI_API_KEY=
# Phase 4 secret: administrative authorization token; unused in phase 1. Ask before use.
ADMIN_TOKEN=
